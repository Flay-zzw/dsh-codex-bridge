{
  "name": "dsh-codex-bridge",
  "version": "0.1.0",
  "description": "Monitor Codex subscription limits and run local Codex tasks from DeepSeek Harness, with optional QQ notifications.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "exports": { ".": "./index.js", "./core": "./src/bridge.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "bin": { "dsh-codex-bridge": "./bin/cli.js" },
  "files": ["index.js", "src", "bin", "cordis.patch.yml", "locale", "icon.svg", "README.md", "LICENSE", "CHANGELOG.md", "docs"],
  "scripts": { "test": "node --test test/*.test.js", "check": "node scripts/check.mjs", "prepack": "node scripts/check.mjs" },
  "keywords": ["dsh", "dsh-plugin", "codex", "qq", "quota", "deepseek-harness"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
